{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "foundernbl-github-io",
  "compatibility_date": "2026-07-27",
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "issues": {
      "enabled": true
    }
  },
  "assets": {
    "directory": "."
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
